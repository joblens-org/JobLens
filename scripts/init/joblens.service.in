[Unit]
Description=JobLens - high-performance job monitoring daemon
Documentation=https://github.com/joblens-org/JobLens
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/JobLens
# 敏感值（ES 口令等）通过 {{ENV}} 占位符读取；文件必须 0600 root。
EnvironmentFile=-/etc/JobLens/secrets.env
# 运行时产物（rpc.sock / FIFO / LevelDB / 日志）只允许 root 访问。
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
@JOBLENS_SERVICE_ENV@
ExecStartPre=@CMAKE_INSTALL_FULL_BINDIR@/JobLens -v
ExecStartPre=-/bin/sh -c 'mountpoint -q /sys/fs/bpf || mount -t bpf bpf /sys/fs/bpf'
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/JobLens \
          -m service \
          -c /etc/JobLens/config.yaml
ExecStopPost=-/bin/rm -f /var/JobLens/JobLens.lock
ExecStopPost=-/bin/rm -rf /sys/fs/bpf/joblens
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
SyslogIdentifier=joblens

[Install]
WantedBy=multi-user.target
