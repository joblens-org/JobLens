#include "collector/__YOUR_COLLECTOR_NAME___collector.h"
#include "core/collector_registry.hpp"
#include "core/output_context.hpp"
#include <spdlog/spdlog.h>
#include <chrono>
#include <fstream>
#include <sstream>

/*================ 注册到工厂 ================*/
AUTO_REGISTER_JOB_COLLECTOR(
    __YOUR_COLLECTOR_NAME__Collector,
    "Put a short description here",
    ConfigParams{
        {"freq", "Sampling frequency in Hz, default 0.2"},
        {"summary", "Whether to summarize (true/false), default false"}
    }
)

/*================ 生命周期 ================*/
bool __YOUR_COLLECTOR_NAME__Collector::init(const nlohmann::json& cfg, CollectorInitContext& /*context*/) {
    if (cfg.contains("freq")) freq_ = cfg["freq"].get<double>();
    if (cfg.contains("summary") && cfg["summary"].get<std::string>() == "true")
        summary_ = true;
    spdlog::info("__YOUR_COLLECTOR_NAME__Collector init ok");
    return true;
}

void __YOUR_COLLECTOR_NAME__Collector::deinit() noexcept {
    last_value_.clear();
    spdlog::info("__YOUR_COLLECTOR_NAME__Collector deinit");
}

/*================ 采集接口 ================*/
std::vector<__YOUR_COLLECTOR_NAME__Data>
__YOUR_COLLECTOR_NAME__Collector::sample_job(const Job& job) {
    std::vector<__YOUR_COLLECTOR_NAME__Data> ret;
    for (int pid : pids_of(job)) {
        __YOUR_COLLECTOR_NAME__Data d;
        d.pid = pid;
        // TODO: 填入业务逻辑，读 /proc/pid/xxx 等
        ret.emplace_back(d);
    }
    if (summary_) { /* 可选：汇总逻辑 */ }
    return ret;
}

std::vector<OutputChannel> __YOUR_COLLECTOR_NAME__Collector::output_channels() const {
    // 只声明实际能产出的通道；未声明/未配置的通道不会产生任何输出。
    return {{"document", OutputKind::Document}, {"text", OutputKind::Text}};
}

nlohmann::json __YOUR_COLLECTOR_NAME__Collector::to_document(
    const std::vector<__YOUR_COLLECTOR_NAME__Data>& data) const {
    nlohmann::json root;
    root["process_data"] = nlohmann::json::array();
    for (const auto& v : data) {
        root["process_data"].push_back({{"pid", v.pid}, {"value", v.value}});
    }
    return root;
}

std::string __YOUR_COLLECTOR_NAME__Collector::to_text(
    const std::vector<__YOUR_COLLECTOR_NAME__Data>& data) const {
    std::ostringstream out;
    for (const auto& v : data) {
        out << "__YOUR_COLLECTOR_NAME__Collector process pid=" << v.pid
            << " value=" << v.value << '\n';
    }
    return out.str();
}

CollectOutcome __YOUR_COLLECTOR_NAME__Collector::collect(const Job& job, OutputContext& output) {
    // 提前判断需要构造哪些表示；采样只执行一次。
    const bool want_document = output.enabled("document");
    const bool want_text = output.enabled("text");
    if (!want_document && !want_text) return {};
    const auto data = sample_job(job);
    if (want_document) output.emit("document", Document{to_document(data)});
    if (want_text) output.emit("text", Text{to_text(data)});
    return {};
}
